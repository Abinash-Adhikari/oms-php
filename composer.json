{
    "name": "sb-tech/office-management-system",
    "description": "SB-Tech Office Management System — PHP + MySQL modular monolith",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "phpmailer/phpmailer": "Required for email notifications via SMTP"
    },
    "autoload": {
        "classmap": [
            "classes/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/"
    }
}
