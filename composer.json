{
    "name": "sb-tech/office-management-system",
    "description": "SB-Tech Office Management System — PHP + MySQL modular monolith",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "phpmailer/phpmailer": "Required for email notifications via SMTP"
    },
    "autoload": {
        "classmap": [
            "classes/"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "bash scripts/check_rules.sh",
        "fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php -v",
        "schema:check": "php scripts/check_schema_docs.php",
        "check": [
            "@test",
            "@stan",
            "@lint",
            "@schema:check"
        ]
    }
}
