#!/usr/bin/env bash
#
# Pre-commit hook — READ-ONLY enforcement. It reports and blocks; it never
# modifies the working tree (no auto-fix, no checkout, no stash). Bypass with
# `git commit --no-verify` when you truly must (CI will still catch it).
#
# Enable with:  make hooks   (sets git config core.hooksPath scripts/githooks)
#
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
step() { printf '\n[%s]\n' "$1"; }

# --- 0. Tooling present? -------------------------------------------------
# Hooks must not crash the commit when deps aren't installed — degrade to skip.
if [ ! -f vendor/bin/phpstan ]; then
    echo "vendor/ missing — run 'composer install'. Skipping PHP checks." >&2
    exit 0
fi

# Staged PHP files only (read-only query).
staged_php=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php' || true)
if [ -z "$staged_php" ]; then
    echo "No staged PHP files — nothing to check."
    exit 0
fi

# --- 1. Syntax check (fast fail) -----------------------------------------
step "php -l on staged files"
for f in $staged_php; do
    [ -f "$f" ] || continue   # deleted files
    if ! php -l "$f" > /dev/null 2>&1; then
        php -l "$f"
        fail=1
    fi
done

# --- 2. Rules linter (whole-repo; already scoped to blocking violations) --
step "rules linter (scripts/check_rules.sh)"
bash scripts/check_rules.sh || fail=1

# --- 3. PHPStan on changed files only (keeps commits fast) ----------------
step "phpstan (changed files)"
tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT
# shellcheck disable=SC2086
if ! vendor/bin/phpstan analyse --no-progress --error-format=raw $staged_php > "$tmpfile" 2>&1; then
    cat "$tmpfile"
    echo "Tip: if errors are pre-existing legacy, update phpstan-baseline.neon via:"
    echo "     vendor/bin/phpstan analyse --generate-baseline"
    fail=1
fi

# --- 4. Schema docs freshness ---------------------------------------------
step "Schema.md freshness"
php scripts/check_schema_docs.php > "$tmpfile" 2>&1 || { cat "$tmpfile"; fail=1; }

if [ "$fail" -eq 0 ]; then
    printf '\nPre-commit checks passed.\n'
fi
exit "$fail"
