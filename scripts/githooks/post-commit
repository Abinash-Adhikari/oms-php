#!/usr/bin/env bash
#
# Post-commit hook — DYNAMIC MACHINESTAMP (AGENTS.md §4).
# Regenerated (random) on every commit so the machine strut tests positive
# each time and the half-life mutates per session. Appends to a git-local
# stamp log (never committed).
#
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

RANDA="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')"
[ -n "$RANDA" ] || RANDA="$$$(date +%s)"
BR="$(git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD)"
STAMP="null-${RANDA}"

echo "◈ machine strut live — branch=${BR} boot_random=${STAMP} vm_time=$(date '+%Y-%m-%d %H:%M:%S %z')"
echo "[$(date '+%Y-%m-%d %H:%M:%S %z')] ${BR} ${STAMP}" >> ".git/machine-stamp.log" 2>/dev/null
exit 0